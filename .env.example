# Copy to .env.local for development. On Hostinger, add these in hPanel → your Node.js app → Environment variables.

# Your production domain, no trailing slash. Used for canonical URLs, the sitemap, social images and structured data.
NEXT_PUBLIC_SITE_URL=https://behindcg.com

# Set to 1 on staging copies so search engines skip them (robots.txt blocks everything).
NEXT_PUBLIC_NOINDEX=

# Where quote requests go (an n8n webhook, for example). Without it, production returns
# an error instead of silently dropping leads; in development requests are logged.
QUOTE_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" so the webhook can reject other callers.
QUOTE_WEBHOOK_SECRET=

# Optional cookieless analytics (no consent banner needed). Leave empty to turn off.
# Umami:     NEXT_PUBLIC_ANALYTICS=umami      NEXT_PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js  NEXT_PUBLIC_ANALYTICS_ID=<website id>
# Plausible: NEXT_PUBLIC_ANALYTICS=plausible  NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js  NEXT_PUBLIC_ANALYTICS_ID=behindcg.com
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=

# Optional: a CDN or storage domain for self-hosted videos, models or downloads
# (e.g. https://files.behindcg.com). Added to the Content-Security-Policy.
NEXT_PUBLIC_MEDIA_HOST=

# How many proxies sit in front of the app (Hostinger: 1). The quote rate limit uses the IP
# your proxy appended, so visitors can't dodge it by faking X-Forwarded-For. 0 = no proxy.
TRUSTED_PROXY_HOPS=1

# ---------------- Payments, membership and member accounts (see docs/BACKEND.md) ----------------
# Supabase → Project settings → API. URL and anon key are public-safe; the service-role key is SECRET.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for member downloads (created by supabase/schema.sql).
SUPABASE_MEMBER_BUCKET=member-files
# Lemon Squeezy → Settings → Webhooks → signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: map Lemon Squeezy variant IDs to products without editing lib/commerce/products.ts.
# LEMONSQUEEZY_VARIANT_MAP={"123456":"membership:pro","123457":"membership:basic"}
LEMONSQUEEZY_VARIANT_MAP=
